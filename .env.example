# Generate every secret below with: openssl rand -hex 32
# (hex keeps values safe to embed in MongoDB connection URLs)

# Security - shared JWT signing secret for both Feathers services (min. 32 characters)
APP_JWT_SECRET=

# MongoDB root account - admin only, used by mongo-express
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=

# MongoDB application account - readWrite on MONGO_APP_DATABASE only, used by the services
MONGO_APP_DATABASE=logging-backend
MONGO_APP_USERNAME=logging-app
MONGO_APP_PASSWORD=

# mongo-express basic auth (only runs with: docker compose --profile debug up)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=

# Microservices URLs (internal for Docker)
FEATHERS_LOGS_URL=http://feathers-logs-service:8081
FEATHERS_USERS_URL=http://feathers-users-service:8082

# Exposed Ports (optional but recommended)
SAILS_PORT=port
MONGO_EXPRESS_PORT=port
