{
  "name": "feathers-users-service",
  "description": "",
  "version": "0.0.0",
  "homepage": "",
  "private": true,
  "keywords": [
    "feathers"
  ],
  "author": {},
  "contributors": [],
  "bugs": {},
  "engines": {
    "node": ">= 25.8.0"
  },
  "feathers": {
    "language": "js",
    "packager": "npm",
    "database": "mongodb",
    "framework": "express",
    "transports": [
      "rest",
      "websockets"
    ],
    "schema": "json"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "main": "lib/index",
  "type": "module",
  "scripts": {
    "start": "node src",
    "dev": "node --watch src/",
    "prettier": "npx prettier \"**/*.js\" --write",
    "mocha": "cross-env NODE_ENV=test mocha test/ --recursive --exit",
    "test": "npm run mocha",
    "bundle:client": "npm pack --pack-destination ./public"
  },
  "dependencies": {
    "@feathersjs/adapter-commons": "^5.0.43",
    "@feathersjs/authentication": "^5.0.43",
    "@feathersjs/authentication-client": "^5.0.43",
    "@feathersjs/authentication-local": "^5.0.43",
    "@feathersjs/authentication-oauth": "^5.0.43",
    "@feathersjs/configuration": "^5.0.43",
    "@feathersjs/errors": "^5.0.43",
    "@feathersjs/express": "^5.0.43",
    "@feathersjs/feathers": "^5.0.43",
    "@feathersjs/mongodb": "^5.0.43",
    "@feathersjs/schema": "^5.0.43",
    "@feathersjs/socketio": "^5.0.43",
    "@feathersjs/transport-commons": "^5.0.43",
    "compression": "^1.8.1",
    "mongodb": "^6.21.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@feathersjs/cli": "^5.0.43",
    "@feathersjs/rest-client": "^5.0.43",
    "axios": "^1.13.6",
    "cross-env": "^10.1.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1"
  }
}